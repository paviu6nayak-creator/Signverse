# ==============================
# SignVerse Backend Environment
# ==============================

# App
APP_NAME=SignVerse API
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8001

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGO_DB_NAME=signverse

# JWT Auth
JWT_SECRET_KEY=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://signverse.vercel.app

# Email (used for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=SignVerse

# Frontend URL (used to build password reset links)
FRONTEND_URL=http://localhost:5173

# File uploads (profile pictures, dataset uploads)
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# AI Model
MODEL_PATH=../ai-model/models/signverse_model.h5
LABELS_PATH=../ai-model/models/labels.json
PREDICTION_CONFIDENCE_THRESHOLD=0.75
