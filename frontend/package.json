    "test:readiness": "node scripts/testProductionReadiness.js",
    "test:translation": "node scripts/testTranslationLogic.js",
    "test:posture": "node scripts/testPostureComparison.js",
    "test:adaptive": "node scripts/testAdaptiveEngine.js",
    "test:path": "node scripts/testLearningPath.js",
    "test:all": "node scripts/testProductionReadiness.js && node scripts/testTranslationLogic.js && node scripts/testPostureComparison.js && node scripts/testAdaptiveEngine.js && node scripts/testLearningPath.js && node scripts/validateLessons.js && node scripts/validateQuizzes.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "axios": "^1.7.2",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
