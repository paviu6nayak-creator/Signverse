# Base URL of the SignVerse API. In local dev, Vite proxies /api to
# VITE_API_PROXY_TARGET (see vite.config.js), so VITE_API_URL can stay
# relative. In production, point it at your deployed Render API.
VITE_API_URL=/api/v1

# Only used by vite.config.js's dev-server proxy — not read by the app itself.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
